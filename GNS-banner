/* Global Negotiations Support – hero banner */

.hero-banner-section {
  position: relative;
  width: 100%;
  aspect-ratio: 1580 / 540;
  min-height: 220px;
  max-height: 560px;
  overflow: hidden;
  border-radius: 6px;
  background-color: #1b2a1f;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  font-family: "Roboto", "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

/* Dark gradient so the white title stays readable over the photo */
.hero-banner-section .overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.65) 0%,
    rgba(0, 0, 0, 0.35) 30%,
    rgba(0, 0, 0, 0) 60%
  );
  pointer-events: none;
  z-index: 1;
}

/* Title + icon pinned bottom-left */
.banner-content-wrapper {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 0 0 28px 48px;
  box-sizing: border-box;
  z-index: 2;
}

.banner-link {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: #ffffff;
  text-decoration: none;
}

.banner-title {
  margin: 0;
  color: #ffffff;
  font-size: 48px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
}

.banner-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  fill: #ffffff;
  margin-top: 6px;
  transition: transform 0.25s ease;
}

.banner-link:hover .banner-icon,
.banner-link:focus-visible .banner-icon {
  transform: translate(4px, -4px);
}

.banner-link:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 6px;
  border-radius: 4px;
}

/* Tablet */
@media (max-width: 991px) {
  .hero-banner-section {
    aspect-ratio: 16 / 7;
  }
  .banner-content-wrapper {
    padding: 0 0 22px 32px;
  }
  .banner-title {
    font-size: 36px;
  }
  .banner-icon {
    width: 30px;
    height: 30px;
    margin-top: 4px;
  }
}

/* Mobile */
@media (max-width: 600px) {
  .hero-banner-section {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }
  .banner-content-wrapper {
    padding: 0 20px 18px 20px;
  }
  .banner-link {
    gap: 10px;
  }
  .banner-title {
    font-size: 26px;
  }
  .banner-icon {
    width: 22px;
    height: 22px;
    margin-top: 3px;
  }
}
