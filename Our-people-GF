/* Global Fellows – grid + modal */

:root {
  --fellows-teal: #1f8a82;
  --fellows-ink: #111827;
  --fellows-muted: #6b7280;
}

.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 20px 48px;
  box-sizing: border-box;
  background: transparent !important;
  font-family: "Poppins", "Helvetica Neue", Arial, sans-serif;
}

/* ---------- Grid ---------- */

.fellows-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, 280px);
  justify-content: center;
  gap: 24px;
  background: transparent !important;
}

/* .team-card is included because the first card in your HTML uses the old class names */
.fellows-card,
.fellows-grid .team-card {
  width: 280px !important;
  height: 298px !important;
  background: #ffffff;
  border-radius: 16px;
  padding: 28px 20px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-align: center;
  cursor: pointer;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(17, 24, 39, 0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.fellows-card:hover,
.fellows-grid .team-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(17, 24, 39, 0.14);
}

.fellows-photo,
.fellows-grid .team-photo {
  width: 120px;
  height: 120px;
  flex-shrink: 0;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  background: #e5e7eb;
  border: 4px solid #ffffff;
  box-shadow: 0 0 0 1px #e5e7eb, 0 4px 12px rgba(0, 0, 0, 0.12);
  margin-bottom: 18px;
}

.fellows-name,
.fellows-grid .team-name {
  font-family: "Roboto", "Helvetica Neue", Arial, sans-serif;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--fellows-ink);
  margin-bottom: 8px;
}

/* Country line */
.fellows-grid .team-title {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.5;
  color: var(--fellows-teal);
}

/* Years line (second .team-title) */
.fellows-grid .team-title + .team-title {
  margin-top: 2px;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.02em;
  text-transform: none;
  color: var(--fellows-muted);
}

/* ---------- Modal ---------- */

body.fellows-modal-open {
  overflow: hidden;
}

